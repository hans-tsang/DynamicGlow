{
  "version": 1,
  "themes": [
    {
      "id": "custom",
      "adaptive": true,
      "customImage": true,
      "name": "My Wallpaper",
      "desc": "Your own image as the wallpaper, with frosted glass, shadow or glow that follows your icons",
      "page": "custom.html",
      "status": "ready",
      "product": "free",
      "thumb": "linear-gradient(135deg, #1d2b53 0%, #3a2f6b 55%, #7a3f6f 100%)",
      "groups": [
        {
          "name": "Image",
          "params": [
            {
              "key": "fit",
              "label": "Fit",
              "hint": "How the image is placed when its shape differs from the screen",
              "options": [
                "Fill",
                "Fit",
                "Stretch",
                "Center"
              ],
              "default": 0
            },
            {
              "key": "dim",
              "label": "Dim",
              "hint": "Darken the whole image so icon labels stay readable",
              "min": 0,
              "max": 0.7,
              "step": 0.01,
              "default": 0,
              "format": "percent"
            }
          ]
        },
        {
          "name": "Around icons",
          "params": [
            {
              "key": "effect",
              "label": "Effect",
              "hint": "What happens to the image under your icons",
              "options": [
                "None",
                "Frosted",
                "Shadow",
                "Glow"
              ],
              "default": 1
            },
            {
              "key": "sigma",
              "label": "Spread",
              "hint": "How far the effect reaches around each icon",
              "min": 20,
              "max": 200,
              "step": 1,
              "default": 60,
              "unit": "px"
            },
            {
              "key": "strength",
              "label": "Strength",
              "hint": "How strong the effect is",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0.85,
              "format": "percent"
            }
          ]
        },
        {
          "name": "Motion",
          "params": [
            {
              "key": "motion",
              "label": "Slow pan & zoom",
              "hint": "Gently drift and zoom the image (off = fully static, almost no GPU)",
              "options": [
                "Off",
                "Slow",
                "Faster"
              ],
              "default": 0
            }
          ]
        }
      ]
    }
  ]
}
